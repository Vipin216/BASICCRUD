# Store these assignments as an SSM Parameter Store SecureString.
# Replace every value. Use shell-compatible KEY=value syntax.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=notes.example.com
DB_NAME=notes_db
DB_USER=notes_app
DB_PASSWORD=replace-with-the-database-password
DB_HOST=your-postgresql-hostname
DB_PORT=5432
